# Copy to .env.local (never commit real values). Placeholders only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# SECURITY: the Supabase service-role key must NEVER be exposed as NEXT_PUBLIC_*
# or used in user requests / the browser. Background jobs and reviewed admin
# functions only (ARCH §5.3). See the server-only section below.

# --- Phase 1B authentication (server-only; never NEXT_PUBLIC_) ---
# Keyed-HMAC secret (>= 32 chars) for login identifiers, employee-number/IP hashes and the session clock.
# Rotating it invalidates driver login identifiers: re-derive profiles.login_identifier first.
AUTH_SERVER_SECRET=replace-with-a-long-random-secret-of-32-chars-or-more
# The single company this deployment serves (drivers type only employee number + PIN).
FLEETIQ_COMPANY_ID=replace-with-company-uuid
# Reviewed admin functions only (sign-in attempt log/lockout, PIN issue/reset). Do not use elsewhere.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Optional policy overrides (proposed defaults shown): see src/modules/identity-access/domain/auth-config.ts
# AUTH_PIN_LENGTH=6  AUTH_PIN_BLOCK_SEQUENCES=true  AUTH_PIN_BLOCK_REPEATS=true
# AUTH_LOCK_ACCOUNT_MAX_FAILURES=5  AUTH_LOCK_IP_MAX_FAILURES=20  AUTH_LOCK_WINDOW_MINUTES=15
# AUTH_LOCK_ACCOUNT_MINUTES=15  AUTH_LOCK_IP_MINUTES=15
# AUTH_SESSION_DRIVER_HOURS=336  AUTH_SESSION_STAFF_HOURS=12
